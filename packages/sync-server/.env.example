# Puerto en el que escucha el servidor (por defecto 3001)
PORT=3001

# Ruta al archivo de base de datos SQLite
DB_PATH=/data/sync.db

# Clave secreta para firmar los JWT de sesión (mínimo 32 caracteres, generar con: openssl rand -hex 32)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# API key de Resend para enviar magic links (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Dominio desde el que se envían los emails (debe estar verificado en Resend)
RESEND_FROM=noreply@tudominio.com

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=vela://,http://localhost:5173

# URL base del servidor (se usa para construir los magic links en los emails)
BASE_URL=https://sync.tudominio.com
