<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Requerido para que Electron ejecute código JIT (V8) con Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Permite memoria ejecutable sin firma (necesario para algunos módulos nativos) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Permite cargar bibliotecas sin validar su firma (electron-chrome-extensions) -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Permite conexiones de red salientes -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Permite leer y escribir ficheros seleccionados por el usuario -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
